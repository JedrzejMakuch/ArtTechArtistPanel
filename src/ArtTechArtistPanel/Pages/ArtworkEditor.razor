@page "/exhibitions/{ExhibitionId:guid}/artworks/new"
@page "/exhibitions/{ExhibitionId:guid}/artworks/{Id:guid}"
@attribute [Authorize]
@implements IDisposable
@inject ArtworkApiClient Api
@inject ExhibitionApiClient ExhibitionsApi
@inject ArtistProfileApiClient Profiles
@inject AuthSession Session
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Artwork · ArtTech</PageTitle>
<a href="@DetailsRoute">Back to exhibition</a>
<h1>@(Id is null ? "Add artwork" : "Edit artwork")</h1>
<ProblemAlert Problem="error" />
@if (message is not null) { <p class="success" role="status">@message</p> }
@if (loading) { <p role="status">Loading artwork…</p> }
else if (!loaded) { <button @onclick="Load">Try again</button> }
else
{
    <p class="biography">@exhibition!.Title</p>
    <ExhibitionStatus Status="@exhibition.Status" />
    @if (!activeProfile) { <p class="notice">Your profile is inactive. Artwork details are read-only.</p> }
    @if (unavailable) { <p class="notice">This artwork or exhibition is unavailable. Your unsaved input is kept below.</p> }
    @if (exhibition.Status == "published") { <p class="notice">Saved changes and deletion take effect immediately for viewers.</p> }
    @if (artwork is { IsActive: false }) { <p class="notice">This artwork is inactive and hidden from viewers.</p> }
    <section class="card">
        <EditForm Model="form" OnValidSubmit="Save" @key="form" @oninput="() => message = null">
            <DataAnnotationsValidator /><ValidationSummary />
            <fieldset disabled="@(busy || !CanWrite)">
                <label for="artwork-title">Title</label><InputText id="artwork-title" @bind-Value="form.Title" maxlength="200" />
                <label for="artwork-description">Description (optional)</label><InputTextArea id="artwork-description" @bind-Value="form.Description" maxlength="2000" rows="4" />
                <label for="artwork-year">Creation year</label><InputNumber id="artwork-year" @bind-Value="form.CreationYear" min="1" max="@DateTime.UtcNow.Year" />
                <label for="artwork-width">Width (cm)</label><InputNumber id="artwork-width" @bind-Value="form.WidthCm" min="1" max="1000" step="0.01" />
                <label for="artwork-height">Height (cm)</label><InputNumber id="artwork-height" @bind-Value="form.HeightCm" min="1" max="1000" step="0.01" />
                <p class="hint">Physical size in centimeters: 1–1000, with up to two decimal places.</p>
                <label for="artwork-image">@(Id is null ? "Artwork image" : "Replace artwork image (optional)")</label>
                <InputFile id="artwork-image" OnChange="SelectImage" accept="image/jpeg,image/png,.jpg,.jpeg,.png" />
                @if (Id is null)
                {
                    <p class="hint">Select one JPG or PNG image, up to 10 MiB.</p>
                }
                else
                {
                    <p class="hint">This artwork already has an image. It is retained unless you choose a replacement JPG or PNG, up to 10 MiB.</p>
                }
                @if (selectedImage is not null) { <p class="success" role="status">Selected: @selectedImage.FileName</p> }
                @if (fileError is not null) { <p class="validation-message" role="alert">@fileError</p> }
                <label for="artwork-order">Display order</label><InputNumber id="artwork-order" @bind-Value="form.SortOrder" min="0" max="2147483647" />
                <p class="hint">Lower numbers appear first. Equal values use a stable server order; gaps are allowed.</p>
                <button type="submit">@(busy ? "Saving…" : Id is null ? "Create artwork" : "Save changes")</button>
            </fieldset>
        </EditForm>
    </section>
    @if (Id is not null && CanWrite)
    {
        <section class="card" aria-label="Remove artwork">
            @if (confirmDelete)
            {
                <p>Delete this artwork permanently? This cannot be undone. The image at the URL will not be deleted.</p>
                <div class="action-row"><button disabled="@busy" @onclick="Delete">Confirm deletion</button><button class="secondary" disabled="@busy" @onclick="() => confirmDelete = false">Cancel</button></div>
            }
            else { <button class="secondary" disabled="@busy" @onclick="() => confirmDelete = true">Delete artwork</button> }
        </section>
    }
}

@code {
    [Parameter] public Guid ExhibitionId { get; set; }
    [Parameter] public Guid? Id { get; set; }
    private string ListRoute => $"exhibitions/{ExhibitionId}/artworks";
    private string DetailsRoute => $"exhibitions/{ExhibitionId}";
    private CancellationTokenSource lifetime = new();
    private SaveArtworkRequest form = new();
    private OwnArtworkDto? artwork;
    private OwnExhibitionDto? exhibition;
    private ApiProblem? error;
    private string? message, fileError;
    private ArtworkUpload? selectedImage;
    private bool loading, loaded, activeProfile, busy, unavailable, confirmDelete;
    private int version;
    private bool CanWrite => activeProfile && !unavailable;
    private bool Current(int request, int generation) => request == version && generation == Session.Generation && !lifetime.IsCancellationRequested;
    protected override async Task OnParametersSetAsync()
    {
        lifetime.Cancel(); lifetime.Dispose(); lifetime = new(); ++version;
        loading = loaded = busy = unavailable = confirmDelete = false; message = fileError = null; selectedImage = null; artwork = null;
        await Load();
    }
    private async Task Load()
    {
        if (loading) return;
        loading = true; error = null;
        var request = version; var generation = Session.Generation;
        try
        {
            var profile = await Profiles.GetAsync(lifetime.Token);
            if (!Current(request, generation)) return;
            var parent = await ExhibitionsApi.GetAsync(ExhibitionId, lifetime.Token);
            if (!Current(request, generation)) return;
            var result = Id is null ? null : await Api.GetAsync(ExhibitionId, Id.Value, lifetime.Token);
            if (!Current(request, generation)) return;
            activeProfile = profile is { IsActive: true }; exhibition = parent; artwork = result;
            form = result is null ? new() { CreationYear = DateTime.UtcNow.Year } : Metadata(result); loaded = true;
        }
        catch (Exception ex) { if (Current(request, generation)) error = ApiProblem.FromException(ex); }
        finally { if (request == version) loading = false; }
    }
    private static SaveArtworkRequest Metadata(OwnArtworkDto value) => new()
    {
        Title = value.Title, Description = value.Description, CreationYear = value.CreationYear,
        WidthCm = value.WidthCm, HeightCm = value.HeightCm, SortOrder = value.SortOrder
    };
    private async Task SelectImage(InputFileChangeEventArgs args)
    {
        fileError = null; selectedImage = null;
        var file = args.File;
        if (file.Size <= 0) { fileError = "Select a non-empty JPG or PNG image."; return; }
        if (file.Size > ArtworkUpload.MaximumBytes) { fileError = "Image must not exceed 10 MiB."; return; }
        var extension = Path.GetExtension(file.Name);
        var declaredImage = file.ContentType is "image/jpeg" or "image/png";
        if (!declaredImage || extension.ToLowerInvariant() is not (".jpg" or ".jpeg" or ".png"))
        {
            fileError = "Select a JPG or PNG image."; return;
        }
        try
        {
            await using var stream = file.OpenReadStream(ArtworkUpload.MaximumBytes, lifetime.Token);
            using var buffer = new MemoryStream((int)file.Size);
            await stream.CopyToAsync(buffer, lifetime.Token);
            selectedImage = new ArtworkUpload(file.Name, file.ContentType, buffer.ToArray());
        }
        catch (Exception ex) when (ex is IOException or OperationCanceledException)
        {
            if (!lifetime.IsCancellationRequested) fileError = "The selected image could not be read. Choose it again and try again.";
        }
    }
    private async Task Save()
    {
        if (busy || !CanWrite) return;
        if (Id is null && selectedImage is null)
        {
            fileError = "Select an artwork image before creating it."; return;
        }
        busy = true; error = null; message = null; confirmDelete = false;
        var request = version; var generation = Session.Generation;
        try
        {
            var result = await Api.SaveAsync(ExhibitionId, Id, form, selectedImage, lifetime.Token);
            if (!Current(request, generation)) return;
            artwork = result; form = Metadata(result);
            Navigation.NavigateTo(DetailsRoute, replace: true);
        }
        catch (Exception ex)
        {
            if (!Current(request, generation)) return;
            RecordError(ex);
            if (Id is null && (ex is not ApiException || ex is ApiException { Status: >= System.Net.HttpStatusCode.InternalServerError }))
                message = "The create result is uncertain. Check the artwork list before trying again to avoid a duplicate.";
        }
        finally { if (request == version) busy = false; }
    }
    private async Task Delete()
    {
        if (busy || !CanWrite || !confirmDelete || Id is null) return;
        busy = true; error = null; message = null;
        var request = version; var generation = Session.Generation;
        try
        {
            await Api.DeleteAsync(ExhibitionId, Id.Value, lifetime.Token);
            if (Current(request, generation)) Navigation.NavigateTo(DetailsRoute);
        }
        catch (Exception ex) { if (Current(request, generation)) RecordError(ex); }
        finally { if (request == version) busy = false; }
    }
    private void RecordError(Exception ex)
    {
        error = ApiProblem.FromException(ex);
        if (ex is ApiException { Status: System.Net.HttpStatusCode.NotFound }) unavailable = true;
    }
    public void Dispose() { ++version; lifetime.Cancel(); lifetime.Dispose(); }
}
